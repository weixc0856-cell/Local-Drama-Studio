# Copy to .env and fill in this machine's paths. .env is gitignored.
# Model store (FLUX/Wan/LLM weights live here)
DRAMA_MODELS_ROOT=D:/path/to/models
# Directory that holds the local AI services (llama.cpp bins, VoxCPM-Runtime)
DRAMA_AI_HOME=D:/path/to/ai-services
# Optional explicit TTS runtime; defaults to <DRAMA_AI_HOME>/VoxCPM-Runtime
# VOXCPM_RUNTIME=D:/path/to/ai-services/VoxCPM-Runtime
# Where every generated artifact lives (default D:/DramaStudio). Keep it out of the repo.
# DRAMA_OUTPUT_ROOT=D:/DramaStudio
